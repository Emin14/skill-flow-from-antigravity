generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tag {
  id        String   @id @default(uuid())
  name      String   @unique
  color     String?
  icon      String?
  createdAt DateTime @default(now())
  tasks     Task[]   @relation("TaskTags")
}

model Task {
  id                  String           @id @default(uuid())
  title               String
  description         String?
  link                String?
  category            String
  tags                Tag[]            @relation("TaskTags")
  priority            String?          @default("P2")
  goalId              String?
  topicId             String?
  parentTaskId        String?
  parentTask          Task?            @relation("TaskHierarchy", fields: [parentTaskId], references: [id], onDelete: SetNull)
  subtasks            Task[]           @relation("TaskHierarchy")
  sortOrder           Int?
  isRepeating         Boolean          @default(false)
  taskState           String?          // 'active' | 'paused' | 'completed'
  repetitionMode      String?          // 'smart' | 'spaced' | 'schedule' | 'after_completion'
  scheduleFrequency   String?          // 'daily' | 'weekly' | 'monthly'
  afterCompletionDays Int?
  spacedStepIndex     Int?
  currentIntervalDays Float?
  targetRepetitions   Int?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @default(now()) @updatedAt
  occurrences         TaskOccurrence[]
}

model TaskOccurrence {
  id             String    @id @default(uuid())
  taskId         String
  date           String    // "YYYY-MM-DD"
  status         String    @default("Todo") // 'Todo' | 'InProgress' | 'Done'
  note           String?   // Session notes
  startedAt      DateTime?
  activeMinutes  Float?    @default(0)
  pomodorosCount Float?    @default(0)
  smartRating    String?   // 'easy' | 'normal' | 'hard' | 'again'
  completedAt    DateTime?
  task           Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model Goal {
  id          String   @id @default(uuid())
  title       String
  description String?
  color       String
  status      String   @default("Active")
  createdAt   DateTime @default(now())
}

model Topic {
  id        String   @id @default(uuid())
  goalId    String
  parentId  String?
  title     String
  weight    Float    @default(1.0)
  createdAt DateTime @default(now())
}

model Material {
  id              String    @id @default(uuid())
  topicId         String
  title           String
  description     String?
  readTimeMinutes Int?
  type            String    @default("Note")
  content         String?
  isCompleted     Boolean   @default(false)
  completedAt     DateTime?
  createdAt       DateTime  @default(now())
}

model RepeatCard {
  id             String    @id @default(uuid())
  materialId     String
  front          String
  back           String
  interval       Int       @default(1)
  repetitions    Int       @default(0)
  easeFactor     Float     @default(2.5)
  nextReviewDate String
  lastReviewedAt DateTime?
  createdAt      DateTime  @default(now())
}

model ActivityLog {
  id        String   @id @default(uuid())
  type      String
  title     String
  createdAt DateTime @default(now())
}

model InboxItem {
  id        String   @id @default(uuid())
  text      String
  isPinned  Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Category {
  id        String   @id @default(uuid())
  name      String   @unique
  color     String
  createdAt DateTime @default(now())
}
