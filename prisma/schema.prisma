generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Task {
  id                String           @id @default(uuid())
  title             String
  status            String           @default("Todo")
  priority          String           @default("P2")
  category          String
  description       String?
  link              String?
  parentTaskId      String?
  topicId           String?
  goalId            String?
  scheduledDate     String
  isRepeating       Boolean          @default(false)
  repeatStatus      String?          @default("Active")
  repetitionMode    String?          @default("smart")
  scheduleFrequency String?
  createdAt         DateTime         @default(now())
  occurrences       TaskOccurrence[]
}

model TaskOccurrence {
  id             String    @id @default(uuid())
  taskId         String
  date           String
  status         String    @default("Todo")
  completedAt    DateTime?
  pomodorosCount Float?
  task           Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model Goal {
  id          String   @id @default(uuid())
  title       String
  description String?
  color       String
  status      String   @default("Active")
  createdAt   DateTime @default(now())
}

model Topic {
  id        String   @id @default(uuid())
  goalId    String
  parentId  String?
  title     String
  weight    Float    @default(1.0)
  createdAt DateTime @default(now())
}

model Material {
  id              String    @id @default(uuid())
  topicId         String
  title           String
  description     String?
  readTimeMinutes Int?
  type            String    @default("Note")
  content         String?
  isCompleted     Boolean   @default(false)
  completedAt     DateTime?
  createdAt       DateTime  @default(now())
}

model RepeatCard {
  id             String    @id @default(uuid())
  materialId     String
  front          String
  back           String
  interval       Int       @default(1)
  repetitions    Int       @default(0)
  easeFactor     Float     @default(2.5)
  nextReviewDate String
  lastReviewedAt DateTime?
  createdAt      DateTime  @default(now())
}

model ActivityLog {
  id        String   @id @default(uuid())
  type      String
  title     String
  createdAt DateTime @default(now())
}

model InboxItem {
  id        String   @id @default(uuid())
  text      String
  isPinned  Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Category {
  id        String   @id @default(uuid())
  name      String   @unique
  color     String
  createdAt DateTime @default(now())
}
