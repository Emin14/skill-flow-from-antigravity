            },
            {
              "en": "from end to end",
              "ru": "из конца в конец"
            },
            {
              "en": "you will find the word in the seventh line from the bottom (of the page)",
              "ru": "вы найдёте это слово в седьмой строке снизу"
            },
            {
              "en": "from ten to twenty thousand",
              "ru": "от десяти до двадцати тысяч"
            },
            {
              "en": "from my point of view",
              "ru": "с моей точки зрения"
            }
          ]
        },
        {
          "id": 3,
          "partOfSpeech": "preposition",
          "translation": "указывает на временные отношения с, от, из",
          "examples": [
            {
              "en": "from the (very) beginning",
