      "meanings": [
        {
          "id": 1,
          "partOfSpeech": "preposition",
          "translation": "указывает на пространственные отношения от, из, с (передаётся также приставками)",
          "examples": [
            {
              "en": "from St. Petersbourg",
              "ru": "из Санктпетербурга"
            },
            {
              "en": "where is he coming from?",
              "ru": "откуда он?"
            },
            {
              "en": "we are two hours journey from there",
              "ru": "мы находимся в двух часах пути оттуда"
            },
            {
              "en": "we were 50 km from the town",
              "ru": "мы были в 50 км от города"
            }
          ]
        },
        {
          "id": 2,
          "partOfSpeech": "preposition",
          "translation": "указывает на отправную точку, исходный пункт, предел с, от",
          "examples": [
            {
              "en": "from the beginning of the book",
              "ru": "с начала книги"
            },
            {
              "en": "from floor to ceiling",
