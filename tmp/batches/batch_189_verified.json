          "partOfSpeech": "adverb",
          "translation": "указывает на истечение срока, завершение или результат действия",
          "examples": [
            {
              "en": "Parlia ment is up",
              "ru": "сессия парламента закрылась"
            },
            {
              "en": "it is all up with him",
              "ru": "с ним всё покончено"
            },
            {
              "en": "the house burned up",
              "ru": "дом сгорел дотла"
            },
            {
              "en": "to eat up",
              "ru": "съесть"
            },
            {
              "en": "to save up",
              "ru": "скопить"
            }
          ]
        },
