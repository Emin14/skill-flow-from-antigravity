      "meanings": [
        {
          "id": 1,
          "partOfSpeech": "article",
          "translation": "[Si: (полная форма); Si (редуцированная форма, употр. перед гласными), Sa (редуцированная форма, употр. перед согласными)] определённый артикль употр. перед сущ. для выделения предмета или явления внутри данной категории, данного класса предметов и явлений",
          "examples": [
            {
              "en": "the book you mention",
              "ru": "упоминаемая вами книга"
            },
            {
              "en": "I'll speak to the teacher",
              "ru": "я поговорю с преподавателем (тем, который преподаёт в нашем классе)"
            }
          ]
        },
        {
          "id": 2,
          "partOfSpeech": "article",
          "translation": "указывает нато, что данный предмет или лицо известны говорящему",
          "examples": [
            {
              "en": "I dislike the man",
              "ru": "я не люблю этого человека"
            },
            {
              "en": "how is the score?",
              "ru": "какой сейчас счёт?"
            }
          ]
        },
        {
          "id": 3,
          "partOfSpeech": "article",
          "translation": "указывает нато, что данный предмет или лицо являются исключительными, наиболее подходящими, самыми лучшими и тому подобное",
          "examples": [
            {
              "en": "(of all the men I know) he is the man for the position ()",
              "ru": "из всех, кого я знаю,) он самый подходящий человек для этого поста"
            }
          ]
        },
        {
          "id": 4,
          "partOfSpeech": "article",
          "translation": "придаёт сущ. значение родового понятия",
          "examples": [
            {
              "en": "the horse is a domestic animal",
              "ru": "лошадь — домашнее животное"
            }
          ]
        },
        {
          "id": 5,
          "partOfSpeech": "article",
          "translation": "употр. перед сущ., обозначающими предметы или понятия, являющиеся единственны мив своём роде",
          "examples": [
            {
              "en": "the Sun",
              "ru": "Солнце, the Moon Луна"
            }
          ]
        },
        {
          "id": 6,
          "partOfSpeech": "article",
          "translation": "служит граммати ческим средством оформления частично субстантивированных прилагательных а) с абстрактным значением",
          "examples": [
            {
              "en": "it is only a step from the sublime to the ridiculous",
              "ru": "от великого до смешного только один шаг"
            },
            {
              "en": "the wise",
              "ru": "мудрецы"
            }
          ]
        },
        {
          "id": 7,
          "partOfSpeech": "article",
          "translation": "придаёт конк ретному сущ. обобщающее значение",
          "examples": [
            {
              "en": "the stage",
              "ru": "сценическая деятельность"
            },
            {
              "en": "the saddle",
              "ru": "верховая езда"
            }
          ]
        },
        {
          "id": 8,
          "partOfSpeech": "adverb",
          "translation": "употр. при сравн. ст. со значением чем... тем; тем",
          "examples": [
            {
              "en": "the more the better",
              "ru": "чем больше, тем лучше"
            },
            {
              "en": "the less said the better",
              "ru": "чем меньше слов, тем лучше"
            },
            {
              "en": "(so much) the worse for him",
              "ru": "тем хуже для него"
            }
          ]
        }
      ]
