      },
      "meanings": [
        {
          "id": 1,
          "partOfSpeech": "preposition",
          "translation": "указывает на движение или направление внутрь, в сферу или область чего-либо в(о), на",
          "examples": [
            {
              "en": "to go into the house",
              "ru": "войти в дом"
            },
            {
              "en": "to fall, to dive, etc. into the river",
              "ru": "упасть, нырнуть и тому подобное в реку"
            },
            {
              "en": "to walk into the square",
              "ru": "выйти на площадь"
            },
            {
              "en": "to climb high into the mountains",
              "ru": "за браться высоко в горы"
            },
            {
              "en": "to vanish into a crowd",
              "ru": "исчезнуть в толпе"
            },
            {
              "en": "to fall into a mistake",
              "ru": "впасть в ошибку"
            },
            {
              "en": "to work oneself into somebody's favour",
              "ru": "втереться в чьё-либо доверие"
            }
          ]
        },
        {
          "id": 2,
          "partOfSpeech": "preposition",
          "translation": "указывает на достижение какого-либо предмета, столкновение с каким-либо предметом в(о)",
          "examples": [
            {
              "en": "to walk into somebody, something",
              "ru": "натолкнуться (набрести) на кого-либо, что-либо"
            }
          ]
        },
        {
          "id": 3,
          "partOfSpeech": "preposition",
          "translation": "указывает на движение во времени в, к",
          "examples": [
            {
              "en": "her reflections shifted into the past",
              "ru": "она мысленно вернулась к прошлому"
            },
            {
              "en": "looking into the future",
              "ru": "а) заглядывая в будущее"
            }
          ]
        },
        {
          "id": 4,
          "partOfSpeech": "preposition",
          "translation": "указывает на включение в категорию, список и тому подобное в",
          "examples": [
            {
              "en": "to enter into a list",
              "ru": "включить в список"
            }
          ]
        },
        {
          "id": 5,
          "partOfSpeech": "preposition",
          "translation": "указывает на переход в новую форму, иное качество или состояние в(о), на, до",
          "examples": [
            {
              "en": "to turn water into ice",
              "ru": "превращать в лёд"
            },
            {
              "en": "to grow into manhood (womanhood)",
              "ru": "стать взрослым мужчиной (взрослой женщиной)"
            },
            {
              "en": "to transmute water power into electric power",
              "ru": "превращать энергию воды в электрическую энергию"
            },
            {
              "en": "to put (or to lick) into shape",
              "ru": "а) придавать форму"
            },
            {
              "en": "to divide (to cut, to break, etc.) into so many portions",
              "ru": "делить (разрезать, разбивать итак далее) настолько-то частей"
            },
            {
              "en": "to work oneself into a rage",
